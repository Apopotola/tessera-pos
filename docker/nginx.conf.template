# One origin: /api, /sanctum, /storage, /docs and /up go to Laravel (PHP-FPM); everything else to Next.js.
# HTTPS is terminated in front of the container (Render, a Cloudflare tunnel or your own proxy);
# X-Forwarded-Proto is passed on to Laravel as HTTPS so cookies and URLs are secure.
worker_processes 1;
error_log /dev/stderr warn;
pid /run/nginx/nginx.pid;

events { worker_connections 512; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    server_tokens off;
    client_max_body_size 8m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/csv image/svg+xml;

    map $http_x_forwarded_proto $tessera_https {
        default "";
        https   on;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    server {
        # IPv4 only: containers often have no IPv6, and "listen [::]" would stop Nginx from starting.
        listen ${PORT};

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        # API, Sanctum and the Swagger docs: Laravel through PHP-FPM.
        location ~ ^/(api|sanctum|docs)(/|$) {
            root /var/www/tessera/backend/public;
            try_files $uri /index.php?$query_string;
        }

        location = /up {
            root /var/www/tessera/backend/public;
            try_files $uri /index.php?$query_string;
        }

        location = /index.php {
            internal;
            root /var/www/tessera/backend/public;
            fastcgi_pass 127.0.0.1:9000;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root/index.php;
            fastcgi_param HTTPS $tessera_https;
            fastcgi_read_timeout 60s;
        }

        # Public uploads (php artisan storage:link).
        location /storage/ {
            alias /var/www/tessera/backend/storage/app/public/;
            expires 7d;
            access_log off;
        }

        location /_next/static/ {
            proxy_pass http://127.0.0.1:3000;
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
        }

        # Everything else: the web app.
        location / {
            proxy_pass http://127.0.0.1:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        location ~ /\.(?!well-known) {
            deny all;
        }
    }
}
